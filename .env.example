# Copy to .env.local and fill in. .env.local is never committed.

# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Secret — server only. Never prefix these with NEXT_PUBLIC_.
# Needed only for reading drafts or a private dataset.
SANITY_API_READ_TOKEN=
# Shared with the CMS webhook so it can trigger a rebuild of changed pages.
SANITY_REVALIDATE_SECRET=
